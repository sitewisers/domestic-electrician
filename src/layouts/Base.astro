---
import '../styles/global.css';
import { site } from '../data/site';
import Wordmark from '../components/Wordmark.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: '#top', label: 'Home' },
  { href: '#services', label: 'Services' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<meta name="googlebot" content="noindex, nofollow" />
<title>Domestic Electrician Ltd: NICEIC approved electrician in Fareham</title>
<meta name="description" content="Domestic Electrician Ltd is a NICEIC approved electrical company covering Fareham and about four miles around it. Fuse boards, rewires, EICRs, fault-finding and emergency callouts." />
<meta name="theme-color" content="#FFFFFF" />
<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Anton&family=Rubik:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>
</head>
<body class="bg-paper pb-[4.5rem] md:pb-0">

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-white">Skip to content</a>

<header class="sticky top-0 z-40 bg-paper/95 backdrop-blur-md">
  <div class="shell flex h-[4.25rem] items-center justify-between gap-5 lg:h-[4.75rem]">
    <a href="#top" class="shrink-0" aria-label={`${site.name}, back to top`}><Wordmark /></a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Sections">
      {nav.map((item) => (
        <a href={item.href} class="text-[0.9375rem] font-semibold text-ink-soft transition-colors hover:text-ink">{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3 sm:gap-5">
      <a href={site.phoneHref} class="hidden text-[1.0625rem] font-bold tracking-tight text-ink transition-colors hover:text-live sm:block">{site.phoneDisplay}</a>
      <a href={site.phoneHref} class="btn btn--live !px-5 !py-2.5 !text-[0.9375rem]">Call</a>
    </div>
  </div>

  <!-- Section links for phones, where the header row has no room -->
  <nav class="border-t border-rule bg-paper lg:hidden" aria-label="Sections">
    <div class="shell flex h-10 items-center gap-6 overflow-x-auto">
      {nav.map((item) => (
        <a href={item.href} class="whitespace-nowrap text-[0.8125rem] font-semibold text-ink-soft transition-colors hover:text-ink">{item.label}</a>
      ))}
    </div>
  </nav>

  <!-- The header sits on the cable: the run that threads the whole page. -->
  <div class="cable-run--thin" aria-hidden="true"></div>
</header>

<main id="main"><slot /></main>

<!-- The cable closes the page the way it opens it. -->
<div class="cable-run" aria-hidden="true"></div>

<footer class="bg-ink">
  <div class="shell py-12 md:py-14">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xs">
        <Wordmark tone="dark" />
        <p class="mt-5 inline-flex items-center gap-2.5 text-[0.9375rem] font-bold text-white">
          <span class="chip" style="background: linear-gradient(90deg, #2E8B47 0 60%, #F5C400 60%)" aria-hidden="true"></span>
          {site.certification}
        </p>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-white/60">
          Domestic electrical work in {site.town} and roughly four miles around it.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <span class="t-label text-white/50">Get in touch</span>
        <a href={site.phoneHref} class="text-lg font-bold text-white hover:text-signal">{site.phoneDisplay}</a>
        <a href={`mailto:${site.email}`} class="text-[0.9375rem] text-white/70 hover:text-white">{site.email}</a>
        <a href={site.whatsappHref} rel="noopener" class="text-[0.9375rem] text-white/70 hover:text-white">WhatsApp</a>
      </div>

      <nav class="flex flex-col gap-3" aria-label="Footer">
        <span class="t-label text-white/50">Sections</span>
        {nav.map((item) => (
          <a href={item.href} class="text-[0.9375rem] text-white/70 transition-colors hover:text-white">{item.label}</a>
        ))}
      </nav>
    </div>

    <div class="mt-12 border-t border-white/15 pt-6">
      <p class="max-w-2xl text-[0.8125rem] leading-relaxed text-white/45">
        A design concept prepared by Sitewisers for {site.name}. Not the company&rsquo;s official website.
      </p>
    </div>
  </div>
</footer>

<!-- Thumb-reach bar. Most enquiries here arrive from a phone, mid-problem. -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 md:hidden">
  <a href={site.phoneHref} class="btn btn--live !rounded-none !py-4">Call</a>
  <a href={site.whatsappHref} rel="noopener" class="btn btn--signal !rounded-none !py-4">WhatsApp</a>
</div>

</body>
</html>

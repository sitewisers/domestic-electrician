---
import '../styles/global.css';
import { site } from '../data/site';
import Wordmark from '../components/Wordmark.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: '#services', label: 'Services' },
  { href: '#reviews', label: 'Reviews' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<meta name="googlebot" content="noindex, nofollow" />
<title>Domestic Electrician Ltd &mdash; NICEIC approved electrician in Fareham</title>
<meta name="description" content="Lee is a NICEIC approved electrician working in Fareham and about four miles around it. Fuse boards, rewires, EICRs, fault-finding and emergency callouts." />
<meta name="theme-color" content="#1C1B18" />
<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,400..900&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400..600&display=swap"
  rel="stylesheet"
/>
<script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body class="bg-graphite pb-[4.5rem] md:pb-0">

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-sm focus:bg-copper focus:px-4 focus:py-2 focus:text-white t-label">Skip to content</a>

<header class="sticky top-0 z-40 border-b border-white/10 bg-graphite/92 backdrop-blur-md">
  <div class="shell flex h-[4.25rem] items-center justify-between gap-6 md:h-[5rem]">
    <a href="#top" class="shrink-0" aria-label={`${site.name}, back to top`}><Wordmark tone="dark" /></a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Sections">
      {nav.map((item) => (
        <a href={item.href} class="t-label text-bone-soft transition-colors hover:text-bone">{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <a href={site.phoneHref} class="t-mono hidden text-[0.9375rem] text-bone transition-colors hover:text-copper-bright sm:block">{site.phoneDisplay}</a>
      <a href={site.phoneHref} class="btn btn--copper !px-4 !py-2.5 !text-[0.6875rem] lg:!px-5 lg:!py-3">Call Lee</a>
    </div>
  </div>

  <!-- Anchor rail for phones and tablets, where the header row has no
       space for section links. Tight enough not to eat the fold. -->
  <nav class="border-t border-white/10 lg:hidden" aria-label="Sections">
    <div class="shell flex h-9 items-center gap-6 overflow-x-auto sm:gap-9">
      {nav.map((item) => (
        <a href={item.href} class="t-label whitespace-nowrap text-[0.5625rem] text-bone-soft transition-colors hover:text-bone">{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<main id="main"><slot /></main>

<footer class="border-t border-white/10 bg-graphite-deep">
  <div class="shell py-12 md:py-16">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xs">
        <Wordmark tone="dark" />
        <p class="t-label mt-5 text-green-bright">{site.certification}</p>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-bone-soft">
          Domestic electrical work in {site.town} and roughly four miles around it.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <span class="t-label text-bone-soft">Get in touch</span>
        <a href={site.phoneHref} class="t-mono text-lg text-bone link-underline">{site.phoneDisplay}</a>
        <a href={`mailto:${site.email}`} class="t-mono text-[0.9375rem] text-bone-soft link-underline hover:text-bone">{site.email}</a>
        <a href={site.whatsappHref} rel="noopener" class="t-mono text-[0.9375rem] text-bone-soft link-underline hover:text-bone">WhatsApp</a>
      </div>

      <nav class="flex flex-col gap-3" aria-label="Footer">
        <span class="t-label text-bone-soft">Sections</span>
        {nav.map((item) => (
          <a href={item.href} class="t-mono text-[0.9375rem] text-bone-soft transition-colors hover:text-bone">{item.label}</a>
        ))}
      </nav>
    </div>

    <div class="mt-12 border-t border-white/10 pt-6">
      <p class="t-label max-w-2xl leading-[1.9] text-bone-soft/70">
        A design concept prepared by Sitewisers for {site.name}. Not the company&rsquo;s official website.
      </p>
    </div>
  </div>
</footer>

<!-- Thumb-reach bar. Most enquiries here arrive from a phone, mid-problem. -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-px border-t border-white/10 bg-white/10 md:hidden">
  <a href={site.phoneHref} class="btn btn--copper !rounded-none !py-4">Call {site.owner}</a>
  <a href={site.whatsappHref} rel="noopener" class="btn !rounded-none !bg-graphite-raised !py-4 !text-bone">WhatsApp</a>
</div>

<script is:inline>
  // The ways snap on one at a time when the panel comes into view.
  // A plain scroll check rather than IntersectionObserver: the observer
  // only delivers once the tab paints, which can leave the panel stuck
  // off. Reduced motion is handled in CSS — the class lands, nothing moves.
  (function () {
    var panel = document.querySelector('[data-consumer-unit]');
    if (!panel) return;
    var done = false;
    function live() {
      if (done) return;
      done = true;
      panel.classList.add('cu--live');
      window.removeEventListener('scroll', check);
      window.removeEventListener('resize', check);
    }
    function check() {
      var r = panel.getBoundingClientRect();
      var h = window.innerHeight || document.documentElement.clientHeight;
      if (r.top < h * 0.88 && r.bottom > 0) setTimeout(live, 220);
    }
    window.addEventListener('scroll', check, { passive: true });
    window.addEventListener('resize', check);
    check();
  })();
</script>

</body>
</html>

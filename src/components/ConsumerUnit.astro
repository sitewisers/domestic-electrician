---
import { site } from '../data/site';

/**
 * SIGNATURE ELEMENT — the consumer unit.
 *
 * Lee installs these; every homeowner eventually needs one looked at.
 * A wall of neat, labelled ways with nothing left to chance is what a
 * good electrician actually sells. So the label strip carries the
 * trust facts instead of circuit names, and every way is ON.
 *
 * Ways are deliberately unequal in width, the way a real board mixes
 * a wide main switch with narrower MCBs.
 */

const ways = [
  { label: 'NICEIC approved', note: 'Assessed', width: 1.2, cert: true },
  { label: `Since ${site.tradingSinceYear}`, note: 'Ltd co.', width: 0.86 },
  { label: `${site.ratings.trustpilot.score} Trustpilot`, note: `~${site.ratings.trustpilot.approxReviews} reviews`, width: 1.1, star: true },
  { label: `${site.town} + ${site.radiusMiles}mi`, note: 'Covered', width: 0.94 },
];
---

<div class="cu" data-consumer-unit>
  <div class="cu__badge t-label">
    <span>{site.name}</span>
    <span class="cu__main"><span class="cu__main-led"></span>Main switch on</span>
  </div>

  <div class="cu__channel" aria-hidden="true">
    {ways.map((way, i) => (
      <div class={`way-toggle ${way.cert ? 'way-toggle--cert' : ''}`} style={`flex-grow:${way.width};--i:${i}`}>
        <span class="way__well"><span class="way__toggle"></span></span>
      </div>
    ))}
  </div>

  <div class="cu__strip">
    {ways.map((way) => (
      <div class={`way-label ${way.cert ? 'way-label--cert' : ''}`} style={`flex-grow:${way.width}`}>
        <span class="way-label__text">
          {way.star && (
            <svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true" class="inline-block align-[-0.5px] mr-px">
              <path d="M5 0l1.3 3.2L9.7 3.6 7.2 5.9l.8 3.4L5 7.5 2 9.3l.8-3.4L.3 3.6l3.4-.4z" fill="#A85A2C"></path>
            </svg>
          )}{way.label}
        </span>
        <span class="way-label__note">{way.note}</span>
      </div>
    ))}
  </div>
</div>

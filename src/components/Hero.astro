---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import heroPhoto from '../assets/photos/hero-exterior-lights.jpg';
---
<section id="top" class="bg-paper">
  <div class="shell pt-10 md:pt-16">
    <p class="t-label text-ink-soft">
      {site.town} &middot; {site.certification} &middot; Ltd since {site.tradingSinceYear}
    </p>

    <h1 class="t-display t-h1 mt-5 max-w-[15ch]">Every circuit accounted for.</h1>

    <div class="mt-8 grid gap-8 md:grid-cols-[1.2fr_1fr] md:items-end">
      <p class="t-lead max-w-[44ch] text-ink-soft">
        {site.name} is a NICEIC approved electrical company covering {site.town} and about
        four miles around it. Fuse boards, rewires, EICRs and fault-finding &mdash; and the
        small jobs most people struggle to get anyone out for.
      </p>

      <div class="flex flex-col gap-3 sm:flex-row md:justify-end">
        <a href={site.phoneHref} class="btn btn--live !text-[1.0625rem]">Call {site.phoneDisplay}</a>
        <a href={site.whatsappHref} rel="noopener" class="btn btn--ghost">WhatsApp</a>
      </div>
    </div>
  </div>

  <!-- The photo runs full-bleed under the headline: their own finished
       work, lit — the product itself, not decoration. -->
  <div class="mt-10 md:mt-14">
    <Image
      src={heroPhoto}
      alt="Outdoor wall lights fitted to the front of a house in Fareham, lit at dusk"
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading="eager"
      class="block h-[46vh] min-h-[300px] w-full object-cover md:h-[56vh]"
    />
  </div>
</section>

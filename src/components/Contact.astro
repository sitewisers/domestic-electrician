---
import { site } from '../data/site';

// Genuinely useful, and it is what a tradesperson actually asks on the phone.
const readyList = [
  'Your postcode.',
  'What has stopped working, and roughly when it started.',
  'How old the fuse board is, if you happen to know.',
  'Whether anything is tripping, and what you were using when it went.',
];
---
<section id="contact" class="band bg-paper">
  <div class="shell">
    <div class="rounded-2xl border border-mist-deep bg-mist p-7 md:p-12">
      <div class="grid gap-10 md:grid-cols-2 md:gap-14">
        <div>
          <p class="t-label text-copper">Get it looked at</p>
          <h2 class="t-h2 mt-4">Ring us.</h2>

          <a
            href={site.phoneHref}
            class="t-tel mt-6 block font-extrabold text-navy transition-colors hover:text-copper"
            style="font-size: clamp(1.875rem, 5.5vw, 2.75rem); letter-spacing: -0.02em"
          >{site.phoneDisplay}</a>

          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={site.whatsappHref} rel="noopener" class="btn btn--primary">Message on WhatsApp</a>
            <a href={`mailto:${site.email}`} class="btn btn--secondary">Email us</a>
          </div>

          <p class="mt-7 max-w-[40ch] text-[1.0625rem] leading-relaxed text-slate">
            {site.town} and roughly four miles around it &mdash; taking in places like
            Titchfield, Stubbington, Portchester, Park Gate and Warsash. If you are not sure
            whether you are inside that, ring and ask.
          </p>
        </div>

        <div class="rounded-xl border border-mist-deep bg-paper p-6 md:p-8">
          <p class="t-label text-slate-light">Have this ready when you call</p>
          <ul class="mt-5 space-y-4">
            {readyList.map((item) => (
              <li class="flex gap-3 text-[1.0625rem] leading-relaxed text-slate">
                <svg width="17" height="17" viewBox="0 0 16 16" aria-hidden="true" class="mt-1 shrink-0"><path d="M6.2 11.3 3.4 8.5l1.1-1.1 1.7 1.7 5-5 1.1 1.1z" fill="#2F6B4F"></path></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-[0.9375rem] text-slate-light">
            Emergency callouts covered. Email is {site.email}.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { site } from '../data/site';

// Genuinely useful, and it is what a tradesperson actually asks on the phone.
const readyList = [
  'Your postcode.',
  'What has stopped working, and roughly when it started.',
  'How old the fuse board is, if you happen to know.',
  'Whether anything is tripping, and what you were using when it went.',
];
---
<section id="contact" class="band bg-ink">
  <div class="shell">
    <p class="t-label text-white/60">
      Get it looked at
    </p>
    <h2 class="t-display t-h2 mt-4 !text-white">Ring us.</h2>

    <a
      href={site.phoneHref}
      class="t-display mt-6 block !text-signal transition-colors hover:!text-white"
      style="font-size: clamp(2.75rem, 11vw, 6.5rem); letter-spacing: 0.01em"
    >{site.phoneDisplay}</a>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a href={site.whatsappHref} rel="noopener" class="btn btn--signal">Message on WhatsApp</a>
      <a href={`mailto:${site.email}`} class="btn btn--onink">Email us</a>
    </div>

    <div class="mt-14 grid gap-10 border-t border-white/15 pt-10 md:grid-cols-2 md:gap-16">
      <div>
        <p class="t-label text-white/50">Where we work</p>
        <p class="mt-4 max-w-[40ch] text-[1.0625rem] leading-relaxed text-white/80">
          {site.town} and roughly four miles around it, taking in places like
          Titchfield, Stubbington, Portchester, Park Gate and Warsash. If you are not sure
          whether you are inside that, ring and ask.
        </p>
      </div>

      <div>
        <p class="t-label text-white/50">Have this ready when you call</p>
        <ul class="mt-4 space-y-3">
          {readyList.map((item) => (
            <li class="flex gap-3 text-[1.0625rem] leading-relaxed text-white/80">
              <span class="chip mt-2 !h-2 !w-2 bg-signal" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[0.9375rem] text-white/55">
          Emergency callouts covered. Email is {site.email}.
        </p>
      </div>
    </div>
  </div>
</section>

---
interface Props { tone?: 'dark' | 'light'; class?: string }
const { tone = 'dark', class: className = '' } = Astro.props;
// Mark is a breaker seen head-on, rocker flicked up. Drawn from the
// site's own concept — there is no inherited brand asset to carry over.
const body = tone === 'dark' ? '#26241F' : '#EAEAE2';
const rocker = tone === 'dark' ? '#EAEAE2' : '#1C1B18';
---
<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg width="18" height="26" viewBox="0 0 18 26" aria-hidden="true" class="shrink-0">
    <rect x="0.5" y="0.5" width="17" height="25" rx="2.5" fill={body} stroke="#A85A2C" stroke-width="1"></rect>
    <rect x="3.5" y="3.5" width="11" height="9" rx="1.5" fill={rocker}></rect>
    <rect x="5" y="5" width="8" height="2" rx="1" fill="#A85A2C"></rect>
    <rect x="4" y="17" width="10" height="1" fill="#A85A2C" opacity="0.5"></rect>
    <rect x="4" y="20" width="10" height="1" fill="#A85A2C" opacity="0.5"></rect>
  </svg>
  <span class="leading-none">
    <span
      class="block font-[900] tracking-[-0.02em] text-[0.9375rem] uppercase"
      style={`font-family:var(--font-display);font-variation-settings:'wdth' 84;color:${tone === 'dark' ? '#EAEAE2' : '#201F1C'}`}
    >Domestic Electrician</span>
    <span class="t-label block text-[0.5rem] mt-1" style={`color:${tone === 'dark' ? '#A6A297' : '#56534B'}`}>Ltd &middot; Fareham</span>
  </span>
</span>

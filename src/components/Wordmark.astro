---
import Mark from './Mark.astro';
interface Props { tone?: 'light' | 'dark'; class?: string }
const { tone = 'light', class: className = '' } = Astro.props;
const name = tone === 'light' ? '#1A1511' : '#FFFFFF';
const meta = tone === 'light' ? '#8A827B' : 'rgba(255,255,255,.6)';
---
<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <Mark size={38} />
  <span class="leading-none">
    <span
      class="block text-[1.0625rem] uppercase leading-none tracking-[0.01em] sm:text-[1.1875rem]"
      style={`font-family:var(--font-display);color:${name}`}
    >Domestic Electrician</span>
    <span class="t-label mt-1 block text-[0.5625rem]" style={`color:${meta}`}>Ltd &middot; Fareham</span>
  </span>
</span>

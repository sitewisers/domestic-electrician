---
interface Props { tone?: 'light' | 'dark'; class?: string }
const { tone = 'light', class: className = '' } = Astro.props;
// Plain type lockup with a copper rule. No mark: a small local trade
// business reads more credibly with a clean name than a drawn logo.
const name = tone === 'light' ? '#132A43' : '#FFFFFF';
const meta = tone === 'light' ? '#7B8896' : 'rgba(255,255,255,.65)';
---
<span class={`inline-flex items-center gap-3 ${className}`}>
  <span class="h-9 w-[3px] shrink-0 rounded-full bg-copper"></span>
  <span class="leading-none">
    <span
      class="block text-[0.9375rem] font-extrabold uppercase leading-none tracking-[-0.01em] sm:text-base"
      style={`font-family:var(--font-display);color:${name}`}
    >Domestic Electrician</span>
    <span class="t-label mt-1.5 block text-[0.5625rem]" style={`color:${meta}`}>Ltd &middot; Fareham</span>
  </span>
</span>

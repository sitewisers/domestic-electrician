---
import { site } from '../data/site';
import Stars from './Stars.astro';

/**
 * Replaces the old breaker-panel component. Four verified facts, stated
 * plainly. No metaphor, no skeuomorphism — the facts are the point and
 * they are all checkable.
 */
const { trustpilot, google } = site.ratings;
---
<section class="border-y border-mist-deep bg-mist" aria-label="Credentials">
  <div class="shell grid grid-cols-2 gap-x-6 gap-y-7 py-8 md:grid-cols-4 md:gap-8 md:py-9">
    <div>
      <span class="pill-cert t-label">
        <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.2 11.3 3.4 8.5l1.1-1.1 1.7 1.7 5-5 1.1 1.1z" fill="currentColor"></path></svg>
        Approved
      </span>
      <p class="t-h3 mt-3">{site.certification}</p>
      <p class="mt-1 text-sm text-slate-light">Assessed against BS 7671</p>
    </div>

    <div>
      <div class="flex items-center gap-2">
        <Stars score={Number(trustpilot.score)} label={`${trustpilot.score} out of 5 on Trustpilot`} />
      </div>
      <p class="t-h3 mt-3">{trustpilot.score} on Trustpilot</p>
      <p class="mt-1 text-sm text-slate-light">From roughly {trustpilot.approxReviews} reviews</p>
    </div>

    <div>
      <div class="flex items-center gap-2">
        <Stars score={Number(google.score)} label={`${google.score} out of 5 on Google`} />
      </div>
      <p class="t-h3 mt-3">{google.score} on Google</p>
      <p class="mt-1 text-sm text-slate-light">Across Google reviews</p>
    </div>

    <div>
      <span class="t-label text-copper">Since {site.tradingSinceYear}</span>
      <p class="t-h3 mt-3">{site.town} + {site.radiusMiles} miles</p>
      <p class="mt-1 text-sm text-slate-light">Trading as a limited company</p>
    </div>
  </div>
</section>

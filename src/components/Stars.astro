---
interface Props { score: number; label: string }
const { score, label } = Astro.props;
// Filled to the actual score, not rounded up.
const pct = Math.max(0, Math.min(100, (score / 5) * 100));
const star = 'M8 0l2.1 5.1L15.6 5.6l-4 3.6 1.2 5.4L8 11.9 3.2 14.6l1.2-5.4-4-3.6L5.9 5.1z';
---
<span class="relative inline-block leading-none" role="img" aria-label={label}>
  <span class="flex gap-0.5">
    {[0, 1, 2, 3, 4].map(() => (
      <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path d={star} fill="#D8DEE6"></path></svg>
    ))}
  </span>
  <span class="absolute inset-0 flex gap-0.5 overflow-hidden" style={`width:${pct}%`} aria-hidden="true">
    {[0, 1, 2, 3, 4].map(() => (
      <svg width="15" height="15" viewBox="0 0 16 16" class="shrink-0"><path d={star} fill="#B4551F"></path></svg>
    ))}
  </span>
</span>

---
import { site } from '../data/site';
import Stars from './Stars.astro';
import Mark from './Mark.astro';
const { trustpilot, google } = site.ratings;

const ratings = [
  { source: 'Trustpilot', score: trustpilot.score, note: `Out of 5, from roughly ${trustpilot.approxReviews} reviews.` },
  { source: 'Google', score: google.score, note: 'Out of 5, across reviews left on Google.' },
];
---
<section id="reviews" class="band bg-neutral-blue">
  <div class="shell">
    <p class="t-label text-white/70">
      Checked by other people
    </p>
    <h2 class="t-display t-h2 mt-4 max-w-[20ch] !text-white">The ratings, and the approval standing behind them.</h2>

    <div class="mt-10 grid gap-10 md:mt-14 lg:grid-cols-[1fr_1fr_1.25fr] lg:gap-8">
      {ratings.map((rating) => (
        <div>
          <p class="t-label text-white/60">{rating.source}</p>
          <p class="t-display mt-2 text-[4.5rem] !leading-none !text-white md:text-[5.5rem]">{rating.score}</p>
          <div class="mt-3"><Stars score={Number(rating.score)} label={`${rating.score} out of 5 on ${rating.source}`} /></div>
          <p class="mt-3 max-w-[26ch] text-[0.9375rem] text-white/75">{rating.note}</p>
        </div>
      ))}

      <div class="border-t-2 border-white/25 pt-8 lg:border-l-2 lg:border-t-0 lg:pl-8 lg:pt-0">
        <div class="flex items-center gap-3">
          <Mark size={44} tile="#1A1511" />
          <p class="t-display text-[1.5rem] !leading-none !text-white">{site.certification}</p>
        </div>
        <div class="mt-5 space-y-4 text-[1rem] leading-relaxed text-white/85">
          <p>
            NICEIC assess electrical contractors against BS 7671, the UK wiring regulations,
            and re-assess them to keep that approval in place.
          </p>
          <p>
            What it means for you: the work has been checked by somebody other than the
            person who did it, and the certificates you are handed at the end are worth
            something.
          </p>
        </div>
      </div>
    </div>

    <!-- ==========================================================
         REAL REVIEWS GO HERE.
         Nothing is invented, so nothing renders yet. Once we have
         the client relationship and two or three reviews they are happy for
         us to quote, drop them in below: real names as published,
         real wording, no trimming without an ellipsis.
         Uncomment and repeat the <article> per review.

         <div class="mt-6 grid gap-5 md:grid-cols-3 md:gap-6">
           <figure class="rounded bg-white p-6">
             <Stars score={5} label="5 out of 5" />
             <blockquote class="mt-4 text-[1.0625rem] leading-relaxed text-ink-soft">
               Review text exactly as published.
             </blockquote>
             <figcaption class="t-label mt-5 text-ink-faint">Reviewer name &middot; Trustpilot</figcaption>
           </figure>
         </div>
         ========================================================== -->

    <p class="mt-10 max-w-[64ch] text-[0.8125rem] leading-relaxed text-white/55">
      Aggregate ratings as published on Trustpilot and Google. Review counts move over time,
      so treat {trustpilot.approxReviews} as approximate.
    </p>
  </div>
</section>

---
import { site } from '../data/site';
import Stars from './Stars.astro';
const { trustpilot, google } = site.ratings;

const ratings = [
  { source: 'Trustpilot', score: trustpilot.score, note: `Out of 5, from roughly ${trustpilot.approxReviews} reviews.` },
  { source: 'Google', score: google.score, note: 'Out of 5, across reviews left on Google.' },
];
---
<section id="reviews" class="band bg-paper">
  <div class="shell">
    <p class="t-label text-copper">Checked by other people</p>
    <h2 class="t-h2 mt-4 max-w-[24ch]">The ratings, and the approval standing behind them.</h2>

    <div class="mt-10 grid gap-5 md:mt-12 md:gap-6 lg:grid-cols-[1fr_1fr_1.15fr]">
      {ratings.map((rating) => (
        <div class="card card--lift">
          <p class="t-label text-slate-light">{rating.source}</p>
          <p class="mt-4 font-extrabold text-navy" style="font-family: var(--font-display); font-size: clamp(2.75rem, 6vw, 3.5rem); line-height: 1; letter-spacing: -0.03em">{rating.score}</p>
          <div class="mt-4"><Stars score={Number(rating.score)} label={`${rating.score} out of 5 on ${rating.source}`} /></div>
          <p class="mt-4 text-[0.9375rem] text-slate">{rating.note}</p>
        </div>
      ))}

      <div class="card card--lift" style="background: var(--color-certified-wash); border-color: color-mix(in srgb, #2F6B4F 24%, transparent)">
        <span class="pill-cert t-label">
          <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.2 11.3 3.4 8.5l1.1-1.1 1.7 1.7 5-5 1.1 1.1z" fill="currentColor"></path></svg>
          Certification
        </span>
        <p class="t-h3 mt-4">{site.certification}</p>
        <div class="mt-4 space-y-4 text-[1rem] leading-relaxed text-slate">
          <p>
            NICEIC assess electrical contractors against BS 7671, the UK wiring regulations,
            and re-assess them to keep that approval in place.
          </p>
          <p>
            What it means for you: the work has been checked by somebody other than the
            person who did it, and the certificates you are handed at the end are worth
            something.
          </p>
        </div>
      </div>
    </div>

    <!-- ==========================================================
         REAL REVIEWS GO HERE.
         Nothing is invented, so nothing renders yet. Once we have
         the client relationship and 2–3 reviews they are happy for
         us to quote, drop them in below — real names as published,
         real wording, no trimming without an ellipsis.
         Uncomment and repeat the <article> per review.

         <div class="mt-6 grid gap-5 md:grid-cols-3 md:gap-6">
           <article class="stat-panel">
             <Stars score={5} label="5 out of 5" />
             <blockquote class="mt-5 text-[1.0625rem] leading-relaxed text-bone">
               Review text exactly as published.
             </blockquote>
             <figcaption class="t-label mt-5 text-bone-soft">Reviewer name &middot; Trustpilot</figcaption>
           </article>
         </div>
         ========================================================== -->

    <p class="mt-8 max-w-[64ch] text-[0.875rem] leading-relaxed text-slate-light">
      Aggregate ratings as published on Trustpilot and Google. Review counts move over time,
      so treat {trustpilot.approxReviews} as approximate.
    </p>
  </div>
</section>

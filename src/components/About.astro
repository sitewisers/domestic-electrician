---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import onSite from '../assets/photos/about-on-site.jpg';

const facts = [
  { k: 'Trading since', v: site.tradingSince },
  { k: 'Company', v: 'Limited company' },
  { k: 'Certification', v: site.certification },
  { k: 'Covers', v: `${site.town} + approx. ${site.radiusMiles} miles` },
  { k: 'Work', v: 'Domestic electrical' },
];
---
<section id="about" class="band bg-paper">
  <div class="shell">
    <p class="t-label flex items-center gap-2.5 text-ink-soft">
      <span class="chip bg-live" aria-hidden="true"></span>
      About
    </p>
    <h2 class="t-display t-h2 mt-4 max-w-[14ch]">Who you are actually ringing.</h2>

    <div class="mt-9 grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
      <div>
        <div class="max-w-[58ch] space-y-5 text-[1.0625rem] leading-relaxed text-ink-soft md:text-[1.125rem]">
          <p>
            {site.name} has traded as a limited company in {site.town} since {site.tradingSince}.
            It is run by {site.owner}, and the work is domestic electrical: design, installation,
            testing and inspection across {site.town} and roughly four miles around it.
          </p>
          <p>
            Electrical work is one of the few jobs in a house where you cannot check the
            quality yourself once it is finished. The wiring goes back in the wall and you
            take the rest on trust. So the certificate, the approval standing behind it and
            the years of trading are not badges &mdash; they are the only things you have to go on.
            They are all on this page, and you can check every one of them.
          </p>
        </div>

        <!-- PLACEHOLDER: the company's own account of how it works, plus a
           real photograph on a job. Nothing here is invented, so this
           section stays deliberately short. Two or three sentences about
           why the company started and what it will not cut corners on
           will do more than anything we could write.

           Keep the structure company-first. Lee is named once above as a
           supporting fact, not as the section's premise — if we get his
           own words later, drop them in as a short quote attributed to
           him inside that company story rather than rewriting this as a
           personal introduction. -->

        <dl class="mt-10 border-t-2 border-ink">
          {facts.map((fact) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-rule py-3">
              <dt class="t-label text-ink-faint">{fact.k}</dt>
              <dd class="text-right text-[1rem] font-bold text-ink">{fact.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div>
        <!-- Real photograph from the company's own published work. We cannot
             confirm which person this is, so the caption and alt text name
             neither him nor a service we have not verified. -->
        <figure>
          <Image
            src={onSite}
            alt="An electrician on site fitting an outdoor unit"
            widths={[600, 1200]}
            sizes="(min-width: 1024px) 30rem, 92vw"
            loading="lazy"
            class="block w-full object-cover"
            style="aspect-ratio: 2 / 1"
          />
          <figcaption class="mt-2.5 text-[0.9375rem] font-semibold text-ink">On site</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
